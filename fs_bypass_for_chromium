  /* ==================== 16d. INTERSECTIONOBSERVER В СКРЫТОЙ ВКЛАДКЕ ====================
     В скрытой вкладке рендеринг остановлен и IO перестает присылать колбэки —
     детект "тишины". Пока вкладка скрыта, периодически повторно вызываем колбэк
     с последними known-записями и свежим timestamp. */
  if (CFG.spoofIntersectionObserver && CFG.visibility && typeof window.IntersectionObserver === 'function') {
    const NativeIO = window.IntersectionObserver;
    const ioMeta = new WeakMap(); // observer -> {cb, last}
    const ioObservers = new Set();
