    };

    visHooks.push((hidden) => {
      if (hidden) {
        if (!workerTimerSupport) return;
        for (const rec of idleRecs.values()) {
          if (rec.mode !== 'native') continue;
          nativeCIC(rec.nativeId);
          rec.mode = 'worker';
          rec.due = Math.max(Date.now(), rec.start + Math.min(rec.timeout || 1500, 5000));
