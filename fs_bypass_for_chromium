  let hudEl = null;
  const updateHud = () => {
    if (!CFG.hudBadge || !hudEl) return;
    hudEl.textContent = `FS: ${isSpoofActive() ? (sessionMode === 'f11' ? '🟢 F11' : '🟢 ON') : '⚪ OFF'} | BLUR: ${CFG.smartBlur ? '🟢' : '⚪'}`;
  };

  const initHud = () => {
    if (!CFG.hudBadge || !isTopFrame) return;
    try {
      if (hudEl || !document.body) return;
      hudEl = document.createElement('div');
      hudEl.id = '__fse_hud_badge';
      hudEl.title = 'Клик: переключить Fullscreen | Ctrl+Alt+F: переключить режим | Ctrl+Alt+B: Blur | Ctrl+Alt+H: скрыть бейдж';
      hudEl.style.cssText = `
        position: fixed;
        bottom: 12px;
        right: 12px;
        background: rgba(15, 23, 42, 0.85);
        color: #e2e8f0;
        border: 1px solid rgba(148, 163, 184, 0.25);
        padding: 5px 10px;
        border-radius: 12px;
        font-family: monospace;
        font-size: 11px;
        cursor: pointer;
