  if (document.body) initHud();
  else nativeAdd.call(document, 'DOMContentLoaded', initHud, { once: true });

  /* ==================== 19. ПУБЛИЧНОЕ УПРАВЛЕНИЕ И ОТЛАДКА ==================== */
  const api = {
    version: '3.6.0-yabrowser.1',
    cfg: CFG,
    toggle: toggleFullscreenMode,
    enable: () => {
      activateSession(document.documentElement);
      notifyFullscreenEntry(document.documentElement);
      showToast('Fullscreen: ВКЛ');
    },
    disable: () => {
      deactivateSession();
      showToast('Fullscreen: ВЫКЛ');
    },
    toggleBlur: toggleBlurMode,
    get isSessionActive() { return sessionActive; },
    get isSpoofActive() { return isSpoofActive(); },
    get sessionMode() { return sessionMode; },
    get fakeFullscreenElement() { return fakeFullscreenEl; },
    get realFullscreenElement() { return realFullscreenElement(); },
    get lastRealExit() { return lastRealExit; },
    get suppressed() { return suppressedCount; },
    status: () => ({
      version: '3.6.0-yabrowser.1',
      sessionActive,
      isSpoofActive: isSpoofActive(),
      sessionMode,
      realFullscreen: !!realFullscreenElement(),
      fakeElement: fakeFullscreenEl,
      smartBlur: CFG.smartBlur,
      visibility: CFG.visibility,
      timersNormalized,
      timersBackend,
      audioKeepAlive: (() => {
        try { return audioRunningFn ? (audioRunningFn() ? 'running' : 'suspended') : null; }
        catch (_) { return null; }
      })(),
