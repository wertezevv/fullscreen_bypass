    CFG.smartBlur = !CFG.smartBlur;
    showToast(`Smart Blur: ${CFG.smartBlur ? 'ВКЛ' : 'ВЫКЛ'}`);
    updateHud();
  };

  const toggleHudVisibility = () => {
    if (!hudEl) {
      CFG.hudBadge = true;
      initHud();
      showToast('HUD бейдж: ВКЛ');
    } else {
      hudEl.style.display = hudEl.style.display === 'none' ? 'block' : 'none';
      showToast(`HUD бейдж: ${hudEl.style.display === 'none' ? 'СКРЫТ' : 'ПОКАЗАН'}`);
    }
  };

