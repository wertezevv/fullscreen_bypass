  /* ==================== 16e. AUDIO KEEP-ALIVE (АНТИ-ТРОТТЛИНГ FF + CHROMIUM) ====================
     Оба движка исключают из троттлинга таймеров вкладки, "воспроизводящие звук":
     - Firefox: TimeoutManager проверяет IsPlayingAudio() — хватает AudioContext
       в состоянии running, громкость не важна. Worker'ы FF троттлятся тоже.
     - Chromium (Chrome/Edge/Яндекс.Браузер): audible-вкладки (реальный вывод звука
       выше порога тишины) исключены из базового 1с И интенсивного троттлинга;
       с Chrome 88+ "silently audible" (gain=0) не считается. Worker'ы Chromium
       троттлятся вместе со страницей, так что аудио — единственный обход.
     Пока вкладка видима — полная тишина (gain=0); при уходе в фон — НЧ-тон
     audioGain (-48дБ, не слышим, особенно на 150Гц). Autoplay-политика: контекст
     создаётся сразу (suspended), resume() по первому жесту.                    */
  if (CFG.audioKeepAlive && typeof AudioContext !== 'undefined' && !audioRunningFn) {
    let audioCtx = null;
    let audioFailed = false;
    let audioGainNode = null;

    const buildAudio = () => {
      if (audioCtx || audioFailed) return;
      try {
        audioCtx = new AudioContext();
        const osc = audioCtx.createOscillator();
        audioGainNode = audioCtx.createGain();
        osc.type = 'sine';
        osc.frequency.value = CFG.audioFreq || 150;
        audioGainNode.gain.value = 0; // полная тишина, пока вкладка видима
        osc.connect(audioGainNode);
        audioGainNode.connect(audioCtx.destination);
        osc.start();
      } catch (_) {
        audioCtx = null;
        audioGainNode = null;
        audioFailed = true;
      }
    };

    const setAudible = (on) => {
      try {
        if (audioGainNode) audioGainNode.gain.value = on ? (CFG.audioGain != null ? CFG.audioGain : 0.004) : 0;
      } catch (_) {}
    };

    const resumeAudio = () => {
      buildAudio();
      try {
        if (audioCtx && audioCtx.state === 'suspended') {
          const p = audioCtx.resume();
          if (p && typeof p.catch === 'function') p.catch(() => {});
        }
      } catch (_) {}
    };

    audioRunningFn = () => {
      try { return !!(audioCtx && audioCtx.state === 'running'); } catch (_) { return false; }
    };

    // Жесты через нативные слушатели (страница их не видит)
    ['pointerdown', 'mousedown', 'keydown', 'touchstart'].forEach((type) => {
      try { nativeAdd.call(window, type, resumeAudio, { capture: true, passive: true }); } catch (_) {}
      try { nativeAdd.call(document, type, resumeAudio, { capture: true, passive: true }); } catch (_) {}
    });

    // Уход в фон: поднять громкость до audioGain (стать audible для Chromium) и
    // подстраховаться resume(). Возврат: снова полная тишина.
    visHooks.push((hidden) => {
      if (!hidden) { setAudible(false); resumeAudio(); return; }
      resumeAudio();
      setTimeout(() => { try { if (audioCtx && audioCtx.state === 'running') setAudible(true); } catch (_) {} }, 120);
    });

    buildAudio(); // сразу suspended; станет running на первом жесте
  }

  /* ==================== 17. ЗАЩИТА СОСЕДНИХ РИЛМОВ (IFRAMES) ==================== */
  if (CFG.protectRealms && CFG.maskNative) {
    const sanitized = new WeakSet();

