    nativeAdd.call(window, 'keydown', (e) => {
      if (e.ctrlKey && e.altKey) {
        if (e.code === 'KeyF' || e.key === 'f' || e.key === 'F' || e.key === 'а' || e.key === 'А') {
          e.preventDefault();
          e.stopImmediatePropagation();
          toggleFullscreenMode();
        } else if (e.code === 'KeyB' || e.key === 'b' || e.key === 'B' || e.key === 'и' || e.key === 'И') {
          e.preventDefault();
          e.stopImmediatePropagation();
          toggleBlurMode();
        } else if (e.code === 'KeyH' || e.key === 'h' || e.key === 'H' || e.key === 'р' || e.key === 'Р') {
          e.preventDefault();
          e.stopImmediatePropagation();
          toggleHudVisibility();
        }
      }
    }, true);
