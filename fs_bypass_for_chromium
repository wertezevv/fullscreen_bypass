    if (timerWorker) {
      timersBackend = 'worker';
      timerWorker.onmessage = (e) => {
        const rec = recs.get(e.data);
        if (rec && rec.mode === 'worker') fireRec(rec);
      };
    } else {
      // CSP сайта может запрещать blob:-Worker (worker-src/script-src). Резерв:
      // MessageChannel — задачи порта не троттлятся как DOM-таймеры. Дороже по CPU,
      // поэтому только last resort.
      try {
        const mc = new MessageChannel();
        mc.port1.onmessage = (e) => {
          mcActive = false;
          const rec = recs.get(e.data);
          if (rec && rec.mode === 'worker') fireRec(rec);
