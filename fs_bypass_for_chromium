        'if(d.cmd==="s"){if(d.iv){m.set(d.id,setInterval(function(){postMessage(d.id)},d.ms));}',
        'else{m.set(d.id,setTimeout(function(){postMessage(d.id);m.delete(d.id)},d.ms));}}',
        'else if(d.cmd==="c"&&r){clearTimeout(r);clearInterval(r);m.delete(d.id);}};'
