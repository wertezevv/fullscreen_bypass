// ==UserScript==
// @name         Fullscreen Exit Bypass - Yandex Browser Edition
// @namespace    local.userscripts.fullscreen.yabrowser
// @version      3.6.0-yabrowser.1
// @description  Скрывает от страницы выход из полноэкранного режима, потерю фокуса, переключение вкладок, уход курсора и все сопутствующие каналы детекта прокторинга. Сборка под Яндекс.Браузер (Chromium): ставится в Tampermonkey браузера, работает на всех сайтах
// @match        *://*/*
// @match        file:///*
// @run-at       document-start
// @grant        none
// @all-frames   true
// ==/UserScript==

/*
  YANDEX BROWSER BUILD 3.6.0-yabrowser.1: движок идентичен универсальному v3.6.0.
  @match универсальный (сборка под Яндекс.Браузер, а не под его сайты).
  audioKeepAlive включён: в Chromium audible-вкладка исключена из троттлинга
  таймеров (тихий НЧ-тон в фоне). Брэндинг [FSE-YaBrowser] для различения сборок.

  Changelog v3.6.0 (Chromium-фикс, Edge):
  - FIX: современный Chromium (Chrome/Edge/Яндекс.Браузер) троттлит и dedicated
    worker'ы скрытой вкладки вместе со страницей — worker-обход v3.4/3.5 в них
    не работал, дельты ~1000мс палили фон.
  - audioKeepAlive теперь универсален: Chromium исключает из троттлинга (базового
    1с И интенсивного 1/мин) audible-вкладки — с реальным выводом звука выше
    порога тишины ("silently audible" gain=0 с Chrome 88+ не считается).
    Пока вкладка видима — gain=0 (тишина); в фоне — НЧ-тон 150Гц на -48дБ
    (CFG.audioGain/audioFreq): для слуха тишина, для браузера — "играет звук".
    Бонус: audible-вкладки Edge не отправляет в sleeping tabs.
  - Планировщик: при работающем аудио остаёмся на нативных таймерах на ОБОИХ
    движках (фаза точнее worker-круговорота).

  Changelog v3.5.1 (аудит):
  - FIX: boundary-проверки mouseleave/mouseenter использовали подменённый
    window.innerWidth: в фейковом fullscreen реальный край окна не совпадает с
    экранным, и уход/возврат курсора через него не глушлся. Теперь используются
    нативные размеры вьюпорта (nWinIW/nWinIH, захваченные до патчей).
  - FIX: подписки rIC/IntersectionObserver (workerTimerSupport.every) не работали
    при CSP-блокировке Worker (fallback MessageChannel) — они молча отключались.
    Теперь идут через общий управляемый планировщик: оба бэкенда + миграция.
  - Убран отдельный механизм workerSubs — единый путь для всех таймеров.

  Changelog v3.5.0 (Firefox-фикс):
  - audioKeepAlive: беззвучный AudioContext (осциллятор gain=0). Firefox НЕ троттлит
    таймеры вкладки, которая "воспроизводит звук" — TimeoutManager проверяет
    IsPlayingAudio(), куда AudioContext в состоянии running входит независимо от
    громкости. Это полностью отключает троттлинг скрытой вкладки, включая worker'ы
    (Firefox троттлит worker-таймеры через тот же TimeoutManager, поэтому v3.4.0
    на Firefox не спасала). resume() по первому жесту (autoplay-политика).
  - Планировщик таймеров: на Gecko при играющем аудио остаёмся на нативных
    таймерах (точнее worker'а); на Chromium и без аудио — прежняя worker-схема.
  - status(): новое поле audioKeepAlive ('running' | 'suspended' | null).

  Changelog v3.4.0:
  - normalizeTimers переписан: единый планировщик с абсолютным rec.next. Фаза
    таймеров теперь сохраняется при миграции native<->worker<->native (раньше
    интервал перезапускался с нуля и при Alt+Tab давал два поздних тика подряд —
    их и ловил детект "дрейф таймеров" / троттлинг фоновой вкладки).
  - Выравнивание дельты: после опоздания >50мс следующий тик строго через ms —
    страница видит ровные интервалы, аномалия не накапливается и не повторяется.
  - Резервный бэкенд MessageChannel, если CSP сайта запрещает blob:-Worker
    (worker-src/script-src): задачи порта не троттлятся как DOM-таймеры.
  - status(): новое поле timersBackend ('worker' | 'messagechannel' | null).

  Changelog v3.3.0:
  - suppressMouseEnter: глушатся mouseenter/mouseover/pointerenter/pointerover при
    ВОЗВРАТЕ курсора в окно извне (relatedTarget отсутствует, координаты у края).
    Без этого страница видела "enter без leave" — несогласованность = детект.
    Переходы между элементами страницы и тач/перо не затронуты.

  Changelog v3.2.0:
  - Поддержка браузерного F11-fullscreen: F11 не вызывает Fullscreen API и
    fullscreenchange, поэтому раньше подмена при выходе по F11 не включалась.
    Теперь resize-детектор (по нативным размерам окна) распознаёт вход по F11
    и включает "dims-only" сессию: подменяются размеры/бары/хит-тест, но
    document.fullscreenElement остаётся нативным (null), как и при реальном F11.
    Выход по F11 страница не видит (размеры остаются экранными).
  - exitFullscreen() страницы больше не роняет F11-сессию.
  - HUD показывает режим: ON (API) / F11.

  Changelog v3.1.0:
  - trustOnly: глушатся только доверенные (isTrusted=true) события. Синтетические
    self-test'ы страницы (dispatchEvent(new Event('blur'|'fullscreenchange'|...)))
    проходят и видят согласованное фейковое состояние -> детект подмены не срабатывает.
  - Уход курсора: глушатся и pointer-события (pointerleave/pointerout), не только mouse*.
  - Бар-свойства окна: toolbar/menubar/locationbar/personalbar/scrollbars/statusbar
    .visible === false пока активен fullscreen (в оконном режиме true -> палило эмуляцию).
  - elementFromPoint/elementsFromPoint: точки за пределами реального окна (но в пределах
    экрана) возвращают fullscreen-элемент вместо null (в реальном FS документ там есть).
  - Мульти-мониторы: screen.isExtended = false, getScreenDetails() отклоняется.
  - navigator.keyboard.lock()/unlock() эмулируются без реальной блокировки клавиатуры.
  - requestIdleCallback и IntersectionObserver не замирают в скрытой вкладке
    (нативно они привязаны к рендерингу и останавливаются -> канал детекта "тишины").
  - Исправлен TDZ-баг v3.0.0: sanitizeOnProps вызывался из секции video до объявления.
  - Обёртки слушателей наследуют имя оригинала (меньше следов в stack traces).

  Changelog v3.0.0 (относительно v2.1.0):

  ИСПРАВЛЕНО:
  - smartBlur больше не глушит элементные blur/focusout при активном окне (правило
    currentTarget===window/document ломало дропдауны и валидацию инпутов). Теперь
    элементные события глушатся только если окно реально потеряло фокус (нативный hasFocus).
  - mouseout/mouseleave у края окна больше не глушатся при переходе между элементами
    внутри страницы (boundary-проверка только при уходе курсора из окна).
  - overrideEverywhere: в Firefox own-свойство на window с nativeGet=null навсегда
    портило innerWidth/scrollX и др. Теперь нативный геттер резолвится один раз
    (window || Window.prototype) и переиспользуется для всех целей.
  - Собственные слушатели userscript (visHooks) регистрируются ДО capture-suppressor,
    иначе stopImmediatePropagation глушыл и их (баг keepRaf в v2).
  - querySelectorAll/matches корректно обрабатывают :not(:fullscreen) и составные
    селекторы вида "div:fullscreen .child" (раньше возвращался пустой список).
  - Синтетические события (fullscreenchange и др.) помечаются isTrusted=true.
  - HUD/тосты больше не создаются в каждом iframe — только в топ-фрейме.
  - window.__fseBypassInstalled и API больше не enumerable (меньше палева).

  ДОБАВЛЕНО:
  - Глушение window focus/focusin (парный к blur: страница не видит возврат фокуса).
  - Подмена scrollHeight/scrollWidth/scrollLeft/scrollTop, scrollX/scrollY/
    pageXOffset/pageYOffset/scrollMax* (утечка контентной высоты и прокрутки).
  - document.currentFullscreenElement (новое имя в Chrome 129+).
  - Эмуляция video-webkit-fullscreen API (webkitDisplayingFullscreen,
    webkitEnterFullscreen/ExitFullscreen, webkitbegin/endfullscreen).
  - Патч exitPointerLock: программный выход страницы отрабатывает корректно
    (синтетический pointerlockchange), пользовательский Esc по-прежнему скрыт.
  - normalizeTimers: worker-таймеры для скрытой вкладки — защита от дрейф-детекта
    троттлинга setTimeout/setInterval (классический канал "страница в фоне").
  - crossFrameSync: same-origin iframe'ы синхронизируют состояние с топ-фреймом.
  - matchMedia: понимает dvh/svh/lvh/dvw/svw/lvw/vmin/vmax единицы.
*/

(() => {
  'use strict';

  if (window.__fseBypassInstalled) return;
  try {
    Object.defineProperty(window, '__fseBypassInstalled', {
      value: true, writable: false, enumerable: false, configurable: false
    });
  } catch (_) { window.__fseBypassInstalled = true; }

  /* ============================== 0. НАСТРОЙКИ ============================== */
  const CFG = {
    // --- Полноэкранный режим (Fullscreen) ---
    fullscreen: true,                 // подмена document.fullscreenElement, webkit/moz/ms/current свойств
    mockFullscreenRequest: false,     // если true: при вызове el.requestFullscreen() НЕ запрашивать настоящий экранный режим, а сразу эмулировать успех
    fallbackToFakeOnReject: true,     // если настоящий requestFullscreen() отклонен браузером или отменен, переходить в режим эмуляции
    autoFakeOnStart: false,           // сразу считать страницу в полноэкранном режиме с момента загрузки
    autoDetectF11: true,              // авто-детект браузерного F11-fullscreen (окно стало размером с экран) -> dims-only подмена
    blockExitFullscreen: false,       // игнорировать программный вызов exitFullscreen() со стороны страницы
    suppressAllResizeInFake: true,    // полностью глушить события resize пока активен фейковый fullscreen
    videoFullscreenApi: true,         // эмуляция HTMLVideoElement.webkit*-fullscreen API (Safari-стиль видео-плееры)

    // --- Фокус, вкладки и переключение окон (Anti-AltTab / Defocus) ---
    smartBlur: true,                  // глушить blur/focusout при уходе фокуса из окна, НЕ ломая дропдауны и инпуты внутри страницы
    suppressWindowFocus: true,        // глушить window focus/focusin (возврат фокуса), чтобы страница не видела пару "ушел-вернулся"
    visibility: true,                 // visibilityState = 'visible', document.hidden = false, глушить visibilitychange (+ freeze/resume/pagehide)
    alwaysHasFocus: true,             // document.hasFocus() всегда возвращает true

    // --- Мышь и курсор (Mouse / Pointer) ---
    pointerLock: true,                // сохранение fakePointerLockElement + корректный программный exitPointerLock
    mouseLeave: true,                 // глушить mouseleave / mouseout при выходе курсора за пределы окна/монитора
    suppressMouseEnter: true,         // глушить mouseenter / mouseover при возврате курсора в окно (страница не видит пары "ушёл-вернулся")

    // --- Клавиатурные ловушки ---
    escapeKey: true,                  // глушить клавишу Escape пока страница в fullscreen
    suppressF11: false,               // глушить клавишу F11 от перехвата страницей
    suppressAltTabKeys: false,        // глушить одиночные нажатия Alt/Meta, используемые для детекта Alt+Tab
    bypassKeyboardLock: true,         // navigator.keyboard.lock()/unlock() эмулируются без реальной блокировки клавиатуры

    // --- Защита от блокировки копирования/контекстного меню ---
    allowClipboard: true,             // запретить странице блокировать copy/cut/paste
    allowContextMenu: true,           // запретить странице блокировать правый клик (contextmenu)
    allowSelection: true,             // разблокировать выделение текста (selectstart, user-select)

    // --- Геометрия, Селекторы и ResizeObserver ---
    spoofDimensions: true,            // подмена inner/outer/screenX/screenY/avail*, visualViewport, getBoundingClientRect
    spoofScrollMetrics: true,         // scrollHeight/scrollWidth/scrollLeft/scrollTop html/body + scrollX/scrollY/page*Offset/scrollMax* => экранные
    spoofMediaQueries: true,          // matchMedia (display-mode, width, height, orientation, современный range-синтаксис, dvh/dvw единицы)
    spoofFullscreenSelector: true,    // псевдокласс :fullscreen в matches/querySelector/querySelectorAll (с возвратом настоящего NodeList)
    observerSpoof: true,              // подставлять экранные размеры в ResizeObserver
    spoofBarProps: true,              // window.toolbar/menubar/... .visible === false в fullscreen (панели браузера скрыты)
    spoofHitTesting: true,            // elementFromPoint/elementsFromPoint вне реального окна возвращают fullscreen-элемент
    spoofScreenExtended: true,        // screen.isExtended = false, getScreenDetails() отклоняется (скрыть мульти-мониторы)
    resizeAfterExit: true,            // глушить всплеск resize после реального выхода
    resizeWindowMs: 1500,             // окно подавления после выхода (мс)

    // --- Анти-детект и среда выполнения ---
    maskNative: true,                 // маскировка подмененых функций под [native code] в Function.prototype.toString
    forgeIsTrusted: true,             // синтетические события от скрипта получают isTrusted=true
    protectRealms: true,              // санитизация iframe/frame-контекстов (синхронно через appendChild и через getters)
    normalizeTimers: true,            // worker-таймеры в скрытой вкладке: нет троттлинга setTimeout/setInterval (анти дрейф-детект)
    audioKeepAlive: true,             // тихий AudioContext в фоне: вкладка "с играющим аудио" исключена из троттлинга таймеров (FF и Chromium)
    audioGain: 0.004,                 // громкость тона в фоне (-48дБ): ниже порога слышимости, выше порога тишины Chromium
    audioFreq: 150,                   // частота тона (Гц): НЧ-саббас, который ноутбучные динамики не воспроизводят
    spoofIdleCallback: true,          // requestIdleCallback не замирает в скрытой вкладке
    spoofIntersectionObserver: true,  // IntersectionObserver продолжает присылать колбэки в скрытой вкладке
    crossFrameSync: true,             // same-origin дочерние фреймы наследуют состояние сессии топ-фрейма
    keepRaf: false,                   // непрерывный rAF в скрытой вкладке (качает анимации в фоне)
    shieldCspViolations: true,        // блокировать утечку событий securitypolicyviolation для античитов
    trustOnly: true,                  // глушить только isTrusted-события: синтетические self-test'ы страницы проходят и видят согласованное состояние

    // --- Интерфейс и управление ---
    hotkeys: true,                    // горячие клавиши: Ctrl+Alt+F (FS toggle), Ctrl+Alt+B (Blur toggle), Ctrl+Alt+H (HUD toggle)
    hudBadge: true,                   // плавающий ненавязчивый индикатор статуса в углу экрана (только в топ-фрейме)
    debug: false                      // логировать события в консоль
  };
  /* ========================================================================== */

  const FS_EVENTS = new Set([
    'fullscreenchange', 'webkitfullscreenchange', 'mozfullscreenchange', 'MSFullscreenChange',
    'fullscreenerror', 'webkitfullscreenerror', 'mozfullscreenerror', 'MSFullscreenError'
  ]);
  const PL_EVENTS = new Set([
    'pointerlockchange', 'webkitpointerlockchange', 'mozpointerlockchange',
    'pointerlockerror', 'webkitpointerlockerror', 'mozpointerlockerror'
  ]);
  const VIDEO_FS_EVENTS = new Set(['webkitbeginfullscreen', 'webkitendfullscreen']);
  const VIS_EVENTS = new Set(['visibilitychange', 'webkitvisibilitychange']);
  const LIFECYCLE_EVENTS = new Set(['freeze', 'resume', 'pagehide']);
  const FOCUS_EVENTS = new Set(['blur', 'focusout']);
  const FOCUS_GAIN_EVENTS = new Set(['focus', 'focusin']);
  const MOUSE_LEAVE_EVENTS = new Set(['mouseleave', 'mouseout', 'pointerleave', 'pointerout']);
  const MOUSE_ENTER_EVENTS = new Set(['mouseenter', 'mouseover', 'pointerenter', 'pointerover']);
  const KEY_EVENTS = new Set(['keydown', 'keyup', 'keypress']);

  const dbg = (...args) => { if (CFG.debug) console.debug('[fse-bypass-yabrowser]', ...args); };
  let suppressedCount = 0;

  /* ==================== 1. МАСКИРОВКА ПОД НАТИВНЫЙ КОД ==================== */
  const nativeToString = Function.prototype.toString;
  const maskedSources = new WeakMap();
  let patchedToString = null;

  const maskFn = (fn, source) => {
    if (CFG.maskNative && typeof fn === 'function') maskedSources.set(fn, source);
    return fn;
  };

  const makeMethod = (name, impl) => {
    const holder = { [name](...args) { return impl.apply(this, args); } };
    return holder[name];
  };

  const makeGetter = (prop, impl) => {
    const holder = { get [prop]() { return impl.call(this); } };
    return Object.getOwnPropertyDescriptor(holder, prop).get;
  };

  const setFnMeta = (fn, name, length) => {
    try { Object.defineProperty(fn, 'name', { value: name, configurable: true }); } catch (_) {}
    if (typeof length === 'number') {
      try { Object.defineProperty(fn, 'length', { value: length, configurable: true }); } catch (_) {}
    }
    return fn;
  };

  if (CFG.maskNative) {
    patchedToString = makeMethod('toString', function () {
      const fake = maskedSources.get(this);
      return fake !== undefined ? fake : nativeToString.call(this);
    });
    setFnMeta(patchedToString, 'toString', 0);
    maskedSources.set(patchedToString, 'function toString() { [native code] }');
    Function.prototype.toString = patchedToString;
  }

  /* ==================== 2. НАТИВНЫЕ ССЫЛКИ ==================== */
  const nativeAdd = EventTarget.prototype.addEventListener;
  const nativeRemove = EventTarget.prototype.removeEventListener;

  const nativePropGetter = (obj, prop) => {
    try {
      const d = Object.getOwnPropertyDescriptor(obj, prop);
      return d && typeof d.get === 'function' ? d.get : null;
    } catch (_) { return null; }
  };

  const nativeFsGetter = nativePropGetter(Document.prototype, 'fullscreenElement')
    || nativePropGetter(Document.prototype, 'webkitFullscreenElement');
  const nativePlGetter = nativePropGetter(Document.prototype, 'pointerLockElement')
    || nativePropGetter(Document.prototype, 'webkitPointerLockElement');

  const realFullscreenElement = () => {
    if (!nativeFsGetter) return null;
    try { return nativeFsGetter.call(document); } catch (_) { return null; }
  };
  const realPointerLockElement = () => {
    if (!nativePlGetter) return null;
    try { return nativePlGetter.call(document); } catch (_) { return null; }
  };

  const nativeHiddenGetter = nativePropGetter(Document.prototype, 'hidden')
    || nativePropGetter(Document.prototype, 'webkitHidden');
  const realHidden = () => {
    if (!nativeHiddenGetter) return false;
    try { return !!nativeHiddenGetter.call(document); } catch (_) { return false; }
  };

  // Нативные размеры вьюпорта ДО подмены (детектор F11)
  const nWinIW = nativePropGetter(window, 'innerWidth')
    || (typeof Window !== 'undefined' && nativePropGetter(Window.prototype, 'innerWidth')) || null;
  const nWinIH = nativePropGetter(window, 'innerHeight')
    || (typeof Window !== 'undefined' && nativePropGetter(Window.prototype, 'innerHeight')) || null;

  // Нативный hasFocus захватываем ДО его подмены (используется в smartBlur)
  const nativeHasFocusFn = (typeof Document !== 'undefined' && typeof Document.prototype.hasFocus === 'function')
    ? Document.prototype.hasFocus
    : null;
  const realHasFocus = () => {
    try { return nativeHasFocusFn ? nativeHasFocusFn.call(document) : true; } catch (_) { return true; }
  };

  const isTopFrame = (() => {
    try { return window.top === window; } catch (_) { return true; }
  })();

  const ScreenProto = typeof Screen === 'function' ? Screen.prototype : null;
  const nScreen = ScreenProto ? {
    width: nativePropGetter(ScreenProto, 'width'),
    height: nativePropGetter(ScreenProto, 'height'),
    availWidth: nativePropGetter(ScreenProto, 'availWidth'),
    availHeight: nativePropGetter(ScreenProto, 'availHeight'),
    availLeft: nativePropGetter(ScreenProto, 'availLeft'),
    availTop: nativePropGetter(ScreenProto, 'availTop')
  } : {};

  const buildRect = (w, h) => {
    try { return new DOMRect(0, 0, w, h); } catch (_) {}
    const rect = { x: 0, y: 0, width: w, height: h, top: 0, left: 0, right: w, bottom: h };
    rect.toJSON = () => ({ x: 0, y: 0, width: w, height: h, top: 0, left: 0, right: w, bottom: h });
    return rect;
  };

  // Полноценная эмуляция NodeList для querySelectorAll
  const makeNodeList = (elements) => {
    const proto = (typeof NodeList !== 'undefined' && NodeList.prototype) || Object.prototype;
    const nl = Object.create(proto);
    for (let i = 0; i < elements.length; i++) {
      nl[i] = elements[i];
    }
    Object.defineProperty(nl, 'length', {
      value: elements.length,
      writable: false,
      enumerable: false,
      configurable: true
    });
    nl.item = maskFn(function (index) {
      const idx = Number(index);
      return (idx >= 0 && idx < elements.length) ? elements[idx] : null;
    }, 'function item() { [native code] }');
    nl.forEach = maskFn(function (callback, thisArg) {
      elements.forEach(callback, thisArg);
    }, 'function forEach() { [native code] }');
    nl[Symbol.iterator] = maskFn(function () {
      return elements[Symbol.iterator]();
    }, 'function values() { [native code] }');
    nl.entries = maskFn(function () { return elements.entries(); }, 'function entries() { [native code] }');
    nl.keys = maskFn(function () { return elements.keys(); }, 'function keys() { [native code] }');
    nl.values = maskFn(function () { return elements.values(); }, 'function values() { [native code] }');
    try {
      Object.defineProperty(nl, Symbol.toStringTag, { value: 'NodeList', configurable: true });
    } catch (_) {}
    return nl;
  };

  /* ==================== 3. СОСТОЯНИЕ И ЭМУЛЯЦИЯ СЕССИИ ==================== */
  let sessionActive = CFG.autoFakeOnStart;
  let sessionMode = CFG.autoFakeOnStart ? 'api' : null; // 'api' | 'f11' | null
  let fakeFullscreenEl = CFG.autoFakeOnStart ? (document.documentElement || null) : null;
  let fakePointerLockEl = null;
  let lastRealExit = 0;
  let wasRealFs = false;
  let syntheticPass = 0;            // >0 пока диспатчатся наши синтетические события (пропуск глушения)
  const forgedEvents = new WeakSet(); // события, для которых isTrusted должен быть true

  const activateSession = (el, mode = 'api') => {
    sessionActive = true;
    sessionMode = mode;
    fakeFullscreenEl = mode === 'api' ? (el || fakeFullscreenEl || document.documentElement || null) : null;
    dbg('session activated (' + mode + '), fakeFullscreenEl:', fakeFullscreenEl);
    updateHud();
  };

  const deactivateSession = () => {
    sessionActive = false;
    sessionMode = null;
    fakeFullscreenEl = null;
    wasRealFs = false;
    dbg('session deactivated');
    updateHud();
  };

  // API-fullscreen (в отличие от F11-режима): подменяем document.fullscreenElement
  // и псевдокласс :fullscreen. В F11-режиме эти свойства остаются нативными (null),
  // потому что при реальном F11 они тоже null — подмена выдала бы себя.
  const apiFsActive = () => sessionMode === 'api' || !!fakeFullscreenEl || !!realFullscreenElement();

  // Синхронизация с топ-фреймом (только same-origin; кросс-домен кидает SecurityError)
  let topApi = null;
  let topChecked = false;
  const topSpoofActive = () => {
    if (!CFG.crossFrameSync || isTopFrame) return false;
    if (!topChecked) {
      topChecked = true;
      try {
        if (window.top !== window && window.top.__fseBypass) topApi = window.top.__fseBypass;
      } catch (_) {}
    }
    try { return !!(topApi && topApi.isSpoofActive); } catch (_) { topApi = null; topChecked = false; return false; }
  };

  // Активен ли режим подмены
  const isSpoofActive = () => {
    return sessionActive || !!fakeFullscreenEl || !!realFullscreenElement() || topSpoofActive();
  };

  const fakeActive = () => {
    return isSpoofActive() && !realFullscreenElement();
  };

  // Диспатч синтетического события с пропуском глушения и isTrusted=true
  const dispatchForged = (target, type) => {
    syntheticPass++;
    try {
      const e = new Event(type, { bubbles: true, cancelable: false });
      forgedEvents.add(e);
      (target || document).dispatchEvent(e);
      if (target && target !== document && target !== window) {
        const e2 = new Event(type, { bubbles: true, cancelable: false });
        forgedEvents.add(e2);
        document.dispatchEvent(e2);
      }
    } catch (_) {} finally { syntheticPass--; }
  };

  /* ==================== 4. СЛУЖЕБНЫЕ СЛУШАТЕЛИ ==================== */
  // ВАЖНО: все собственные слушатели регистрируются ДО установки capture-suppressor,
  // иначе stopImmediatePropagation заглушит и их (баг v2 в keepRaf).

  const visHooks = []; // подписчики на смену реальной видимости (таймеры, rAF)
  try {
    nativeAdd.call(document, 'visibilitychange', () => {
      const hidden = realHidden();
      for (const h of visHooks) { try { h(hidden); } catch (_) {} }
    }, true);
  } catch (_) {}

  // Детектор браузерного F11-fullscreen (без Fullscreen API): окно стало размером
  // с экран. Включает "dims-only" сессию — подменяем размеры/бары/хит-тест,
  // но НЕ fullscreenElement (при реальном F11 он null). Слушатель нативный и
  // зарегистрирован ДО capture-suppressor, поэтому глушение resize его не касается.
  const f11CoversScreen = () => {
    try {
      if (!nWinIW || !nWinIH) return false;
      const w = nWinIW.call(window);
      const h = nWinIH.call(window);
      return Math.abs(w - screen.width) <= 2 && Math.abs(h - screen.height) <= 2;
    } catch (_) { return false; }
  };
  let f11Active = false;
  const checkF11 = () => {
    if (realFullscreenElement()) { f11Active = false; return; }
    const full = f11CoversScreen();
    if (full && !f11Active) {
      f11Active = true;
      if (CFG.autoDetectF11 && !sessionActive) {
        activateSession(document.documentElement, 'f11');
        showToast('F11 fullscreen: подмена размеров включена');
      }
    } else if (!full && f11Active) {
      f11Active = false;
      if (sessionMode === 'f11') {
        lastRealExit = Date.now();
        dbg('F11 exit detected, keeping dims-only session active');
        updateHud();
      }
    }
  };
  try {
    nativeAdd.call(window, 'resize', checkF11, true);
    checkF11();
    nativeAdd.call(document, 'DOMContentLoaded', checkF11, { once: true });
    nativeAdd.call(window, 'load', checkF11, { once: true });
  } catch (_) {}

  const watchFullscreen = () => {
    const el = realFullscreenElement();
    if (el) {
      wasRealFs = true;
      activateSession(el);
      dbg('real fullscreen entered:', el);
    } else if (wasRealFs) {
      wasRealFs = false;
      lastRealExit = Date.now();
      dbg('real exit from fullscreen detected, keeping sessionActive = true');
      updateHud();
    }
  };

  FS_EVENTS.forEach((type) => {
    try { nativeAdd.call(document, type, watchFullscreen, true); } catch (_) {}
    try { nativeAdd.call(window, type, watchFullscreen, true); } catch (_) {}
  });

  PL_EVENTS.forEach((type) => {
    try {
      nativeAdd.call(document, type, () => {
        const el = realPointerLockElement();
        if (el) fakePointerLockEl = el;
      }, true);
    } catch (_) {}
  });

  /* ==================== 5. ПРАВИЛА ПОДАВЛЕНИЯ СОБЫТИЙ ==================== */
  const isWindowOrDoc = (target) => {
    return !target || target === window || target === document
      || target === document.documentElement || target === document.body;
  };

  const shouldSuppressKeyEvent = (event) => {
    if (!event) return false;
    const key = event.key || '';
    const code = event.code || '';
    const keyCode = event.keyCode || 0;

    if (CFG.escapeKey && (key === 'Escape' || key === 'Esc' || code === 'Escape' || keyCode === 27)) {
      return isSpoofActive();
    }
    if (CFG.suppressF11 && (key === 'F11' || code === 'F11' || keyCode === 122)) {
      return true;
    }
    if (CFG.suppressAltTabKeys && (key === 'Alt' || key === 'Meta' || code === 'AltLeft' || code === 'AltRight' || keyCode === 18)) {
      return true;
    }
    return false;
  };

  const shouldSuppressFocusEvent = (event) => {
    if (!CFG.smartBlur) return false;
    const t = event && event.type;
    if (t !== 'blur' && t !== 'focusout') return false;

    // Прямой blur/focusout на window или document — окно потеряло фокус
    if (isWindowOrDoc(event.target)) return true;

    // Переход фокуса МЕЖДУ элементами страницы при активном окне — не трогаем
    // (работают дропдауны, валидация инпутов и т.д.)
    if (t === 'focusout' && event.relatedTarget && !isWindowOrDoc(event.relatedTarget)) {
      return !realHasFocus() ? true : false;
    }

    // Элементный blur/focusout без relatedTarget: глушим только если окно
    // действительно потеряло фокус (нативный hasFocus), иначе это внутренняя логика страницы
    return !realHasFocus();
  };

  const shouldSuppressFocusGainEvent = (event) => {
    if (!CFG.smartBlur || !CFG.suppressWindowFocus) return false;
    const t = event && event.type;
    if (t !== 'focus' && t !== 'focusin') return false;
    // Глушим только фокус самого окна/документа (возврат фокуса). Элементные
    // focus/focusin (клики по инпутам) проходят свободно.
    return isWindowOrDoc(event.target);
  };

  // Реальные размеры вьюпорта: window.innerWidth/innerHeight подменены при активной
  // сессии, поэтому для boundary-проверок мыши нужны нативные значения (иначе
  // в фейковом fullscreen уход курсора за реальный край окна не глушится).
  const realViewportW = () => {
    try { return nWinIW ? nWinIW.call(window) : (window.innerWidth || screen.width); }
    catch (_) { return screen.width; }
  };
  const realViewportH = () => {
    try { return nWinIH ? nWinIH.call(window) : (window.innerHeight || screen.height); }
    catch (_) { return screen.height; }
  };

  const shouldSuppressMouseEvent = (event) => {
    if (!CFG.mouseLeave) return false;
    const t = event && event.type;
    if (t !== 'mouseleave' && t !== 'mouseout') return false;

    // Интересуют только уходы курсора ИЗ окна (relatedTarget отсутствует).
    // Переходы между элементами внутри страницы не глушим (v2 ломала hover у краёв окна).
    const leftWindow = !event.relatedTarget || isWindowOrDoc(event.relatedTarget);
    if (!leftWindow) return false;

    if (isWindowOrDoc(event.target)) return true;

    // Курсор ушёл с элемента у края окна наружу
    const x = event.clientX;
    const y = event.clientY;
    if (typeof x === 'number' && typeof y === 'number') {
      const w = realViewportW();
      const h = realViewportH();
      if (x <= 1 || y <= 1 || x >= w - 1 || y >= h - 1) {
        return true;
      }
    }
    return false;
  };

  const shouldSuppressMouseEnterEvent = (event) => {
    if (!CFG.suppressMouseEnter) return false;
    const t = event && event.type;
    if (t !== 'mouseenter' && t !== 'mouseover' && t !== 'pointerenter' && t !== 'pointerover') return false;
    // Тач/перо не трогаем: на них завязаны tap-меню
    if ((t === 'pointerenter' || t === 'pointerover') && event.pointerType && event.pointerType !== 'mouse') {
      return false;
    }
    // Интересует только возврат ИЗ-ЗА пределов окна (relatedTarget отсутствует
    // или внешний). Переходы между элементами страницы работают как обычно.
    const fromOutside = !event.relatedTarget || isWindowOrDoc(event.relatedTarget);
    if (!fromOutside) return false;

    if (isWindowOrDoc(event.target)) return true;

    // Курсор вошёл в элемент у края окна снаружи
    const x = event.clientX;
    const y = event.clientY;
    if (typeof x === 'number' && typeof y === 'number') {
      const w = realViewportW();
      const h = realViewportH();
      if (x <= 1 || y <= 1 || x >= w - 1 || y >= h - 1) {
        return true;
      }
    }
    return false;
  };

  const shouldSuppress = (event) => {
    if (!event) return false;
    if (syntheticPass > 0) return false; // Пропуск наших синтетических событий
    if (CFG.trustOnly && event.isTrusted === false) return false; // self-test'ы страницы проходят и видят согласованное состояние

    const t = event.type;
    if (!t) return false;

    // 1. Полноэкранный режим: глушим событие выхода, пока сессия активна
    if (FS_EVENTS.has(t)) {
      return isSpoofActive() && !realFullscreenElement();
    }
    if (VIDEO_FS_EVENTS.has(t)) {
      return isSpoofActive() && !realFullscreenElement();
    }

    // 2. Pointer lock
    if (PL_EVENTS.has(t)) {
      return !!fakePointerLockEl && !realPointerLockElement();
    }

    // 3. Клавиатура (Esc, F11, Alt)
    if (KEY_EVENTS.has(t)) {
      return shouldSuppressKeyEvent(event);
    }

    // 4. Видимость вкладки и жизненный цикл страницы
    if (CFG.visibility && (VIS_EVENTS.has(t) || LIFECYCLE_EVENTS.has(t))) {
      return true;
    }

    // 5. Умный blur (защита от детекта смены окна без поломки дропдаунов)
    if (FOCUS_EVENTS.has(t)) {
      return shouldSuppressFocusEvent(event);
    }

    // 5b. Возврат фокуса в окно (парный к blur — страница не должна видеть "вернулся")
    if (FOCUS_GAIN_EVENTS.has(t)) {
      return shouldSuppressFocusGainEvent(event);
    }

    // 6. Уход курсора мыши
    if (MOUSE_LEAVE_EVENTS.has(t)) {
      return shouldSuppressMouseEvent(event);
    }

    // 6b. Возврат курсора в окно: без этого страница видит "enter без leave",
    // что само по себе признак подмены
    if (MOUSE_ENTER_EVENTS.has(t)) {
      return shouldSuppressMouseEnterEvent(event);
    }

    // 7. Resize во время активной сессии
    if (t === 'resize') {
      if (CFG.suppressAllResizeInFake && isSpoofActive()) return true;
      if (CFG.resizeAfterExit && (Date.now() - lastRealExit < CFG.resizeWindowMs)) return true;
    }

    return false;
  };

  // Top-level capture глушение: останавливает событие ДО того, как оно дойдет до слушателей страницы
  const captureSuppressor = (event) => {
    if (shouldSuppress(event)) {
      suppressedCount++;
      dbg('capture suppressed', event && event.type);
      try {
        event.stopImmediatePropagation();
        event.stopPropagation();
        if (event.cancelable) event.preventDefault();
      } catch (_) {}
    }
  };

  const ALL_CAPTURED_EVENTS = [
    ...FS_EVENTS, ...PL_EVENTS, ...VIDEO_FS_EVENTS, ...VIS_EVENTS, ...LIFECYCLE_EVENTS,
    'blur', 'focusout', 'focus', 'focusin', ...MOUSE_LEAVE_EVENTS, ...MOUSE_ENTER_EVENTS, 'resize'
  ];

  ALL_CAPTURED_EVENTS.forEach((type) => {
    try { nativeAdd.call(window, type, captureSuppressor, true); } catch (_) {}
    try { nativeAdd.call(document, type, captureSuppressor, true); } catch (_) {}
  });

  // Защита от детекта CSP-нарушений (когда античит слушает securitypolicyviolation)
  if (CFG.shieldCspViolations) {
    const suppressCsp = (e) => {
      try {
        if (e && (e.blockedURI && (e.blockedURI.startsWith('blob:') || e.blockedURI.startsWith('data:')))) {
          e.stopImmediatePropagation();
          e.stopPropagation();
        }
      } catch (_) {}
    };
    try { nativeAdd.call(window, 'securitypolicyviolation', suppressCsp, true); } catch (_) {}
    try { nativeAdd.call(document, 'securitypolicyviolation', suppressCsp, true); } catch (_) {}
  }

  // Обёртка на слушателя
  const wrappedGeneric = new WeakMap();
  const genericWrap = (listener) => {
    let w = wrappedGeneric.get(listener);
    if (w) return w;
    const isFn = typeof listener === 'function';
    w = function (event) {
      if (shouldSuppress(event)) {
        suppressedCount++;
        dbg('wrapped listener suppressed', event && event.type);
        return;
      }
      return isFn ? listener.call(this, event) : listener.handleEvent(event);
    };
    try {
      if (isFn && listener.name) Object.defineProperty(w, 'name', { value: listener.name, configurable: true });
    } catch (_) {}
    wrappedGeneric.set(listener, w);
    return w;
  };

  /* ==================== 6. MATCHMEDIA И СОВРЕМЕННЫЙ RANGE СИНТАКСИС ==================== */
  const parseLength = (raw, isWidth, w, h) => {
    const m = /^(-?[\d.]+)(px|rem|em|vw|vh|vmin|vmax|dvw|svw|lvw|dvh|svh|lvh)?$/i.exec(String(raw).trim());
    if (!m) return null;
    let val = parseFloat(m[1]);
    const unit = (m[2] || 'px').toLowerCase();
    if (unit === 'rem' || unit === 'em') val *= 16;
    else if (unit === 'vw' || unit === 'dvw' || unit === 'svw' || unit === 'lvw') val = (val * w) / 100;
    else if (unit === 'vh' || unit === 'dvh' || unit === 'svh' || unit === 'lvh') val = (val * h) / 100;
    else if (unit === 'vmin') val = (val * Math.min(w, h)) / 100;
    else if (unit === 'vmax') val = (val * Math.max(w, h)) / 100;
    return val;
  };

  const evaluateMediaQuery = (query, w, h) => {
    if (typeof query !== 'string' || !query.trim()) return null;

    const evalPart = (part) => {
      let m;
      // Традиционный min/max: min-width: 1000px
      if ((m = /^(min|max)-(width|height)\s*:\s*([^\s)]+)$/i.exec(part))) {
        const isMin = m[1].toLowerCase() === 'min';
        const isW = m[2].toLowerCase() === 'width';
        const val = parseLength(m[3], isW, w, h);
        if (val === null) return null;
        const cur = isW ? w : h;
        return isMin ? cur >= val : cur <= val;
      }

      // Традиционный точный: width: 1920px
      if ((m = /^(width|height)\s*:\s*([^\s)]+)$/i.exec(part))) {
        const isW = m[1].toLowerCase() === 'width';
        const val = parseLength(m[2], isW, w, h);
        if (val === null) return null;
        return (isW ? w : h) === val;
      }

      // Современный CSS range: (width >= 1000px), (height <= 800px)
      if ((m = /^(width|height)\s*(>=|<=|>|<|=)\s*([^\s)]+)$/i.exec(part))) {
        const isW = m[1].toLowerCase() === 'width';
        const op = m[2];
        const val = parseLength(m[3], isW, w, h);
        if (val === null) return null;
        const cur = isW ? w : h;
        if (op === '>=' || op === '=') return cur >= val;
        if (op === '<=') return cur <= val;
        if (op === '>') return cur > val;
        if (op === '<') return cur < val;
      }

      // Современный двусторонний диапазон: (1000px <= width <= 2000px)
      if ((m = /^([^\s)]+)\s*(<=|<)\s*(width|height)\s*(<=|<)\s*([^\s)]+)$/i.exec(part))) {
        const isW = m[3].toLowerCase() === 'width';
        const min = parseLength(m[1], isW, w, h);
        const max = parseLength(m[5], isW, w, h);
        if (min === null || max === null) return null;
        const cur = isW ? w : h;
        const minOk = m[2] === '<=' ? cur >= min : cur > min;
        const maxOk = m[4] === '<=' ? cur <= max : cur < max;
        return minOk && maxOk;
      }

      // display-mode: fullscreen
      if ((m = /^display-mode\s*:\s*([\w-]+)$/i.exec(part))) {
        return m[1].toLowerCase() === 'fullscreen';
      }

      // orientation: landscape / portrait
      if ((m = /^orientation\s*:\s*(landscape|portrait)$/i.exec(part))) {
        return (w >= h ? 'landscape' : 'portrait') === m[1].toLowerCase();
      }

      // aspect-ratio: 16/9
      if ((m = /^aspect-ratio\s*:\s*([\d.]+)\s*\/\s*([\d.]+)$/i.exec(part))) {
        const expected = parseFloat(m[1]) / parseFloat(m[2]);
        return Math.abs((w / h) - expected) < 0.02;
      }

      return null;
    };

    let anyKnown = false;
    let overall = false;

    for (const altRaw of query.toLowerCase().split(',')) {
      let altOk = true;
      let altKnown = false;
      for (let raw of altRaw.split(/\s+and\s+/)) {
        let part = raw.trim().replace(/^only\s+/, '');
        if (part === 'all' || part === 'screen' || part === '') continue;
        part = part.replace(/^\(/, '').replace(/\)$/, '').trim();
        if (!part) continue;
        const r = evalPart(part);
        if (r === null) return null;
        altKnown = true;
        if (!r) altOk = false;
      }
      if (altKnown) {
        anyKnown = true;
        if (altOk) overall = true;
      }
    }
    return anyKnown ? overall : null;
  };

  const mqResult = (media) => {
    if (!CFG.spoofMediaQueries || !isSpoofActive()) return null;
    return evaluateMediaQuery(media, screen.width, screen.height);
  };

  const spoofedMqls = new WeakSet();
  const installMqlOverride = (mql, query) => {
    if (!mql || spoofedMqls.has(mql)) return;
    const d = nativePropGetter(MediaQueryList.prototype, 'matches');
    if (!d) return;
    const getter = maskFn(makeGetter('matches', function () {
      const fake = mqResult(query);
      return fake === null ? d.call(this) : fake;
    }), 'function get matches() { [native code] }');
    try {
      Object.defineProperty(mql, 'matches', { configurable: true, enumerable: true, get: getter });
      spoofedMqls.add(mql);
    } catch (_) {}
  };

  const wrapMqlChangeEvent = (event, mql) => {
    const fake = mqResult(String(mql.media || ''));
    if (fake === null) return event;
    try {
      return new Proxy(event, {
        get(target, prop) {
          if (prop === 'matches') return fake;
          const value = target[prop];
          return typeof value === 'function' ? value.bind(target) : value;
        }
      });
    } catch (_) { return event; }
  };

  const mqlWrapped = new WeakMap();
  const mqlWrap = (mql, listener) => {
    let perMql = mqlWrapped.get(mql);
    if (!perMql) { perMql = new WeakMap(); mqlWrapped.set(mql, perMql); }
    let w = perMql.get(listener);
    if (!w) {
      const base = genericWrap(listener);
      w = function (event) { return base.call(this, wrapMqlChangeEvent(event, mql)); };
      perMql.set(listener, w);
    }
    return w;
  };
  const mqlUnwrap = (mql, listener) => {
    const perMql = mqlWrapped.get(mql);
    return perMql ? (perMql.get(listener) || listener) : listener;
  };

  /* ==================== 7. ПАТЧ ADDEVENTLISTENER / REMOVEEVENTLISTENER ==================== */
  const isWatchedEvent = (type) => {
    return FS_EVENTS.has(type) || PL_EVENTS.has(type) || VIDEO_FS_EVENTS.has(type)
      || VIS_EVENTS.has(type) || LIFECYCLE_EVENTS.has(type) || FOCUS_EVENTS.has(type)
      || FOCUS_GAIN_EVENTS.has(type) || KEY_EVENTS.has(type)
      || MOUSE_LEAVE_EVENTS.has(type) || MOUSE_ENTER_EVENTS.has(type) || type === 'resize';
  };

  const patchedAdd = maskFn(makeMethod('addEventListener', function (type, listener, options) {
    if (typeof type !== 'string' || listener == null
        || (typeof listener !== 'function' && typeof listener !== 'object')) {
      return nativeAdd.call(this, type, listener, options);
