  }

  /* ==================== 18. ПОЛЬЗОВАТЕЛЬСКИЙ ИНТЕРФЕЙС И ГОРЯЧИЕ КЛАВИШИ ==================== */
  const showToast = (message) => {
    if (!isTopFrame) return; // никакого UI внутри iframe
    try {
      const id = '__fse_toast_notice';
      let toast = document.getElementById(id);
      if (!toast) {
        toast = document.createElement('div');
        toast.id = id;
        toast.style.cssText = `
          position: fixed;
          top: 14px;
          right: 14px;
          background: rgba(18, 24, 38, 0.92);
          color: #5ce1e6;
          border: 1px solid rgba(92, 225, 230, 0.4);
          padding: 8px 16px;
          border-radius: 6px;
          font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
          font-size: 13px;
          font-weight: 500;
          box-shadow: 0 4px 14px rgba(0,0,0,0.35);
          z-index: 2147483647;
