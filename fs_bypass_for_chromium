      if (!rafQueue.size) return;
      if (!realHidden()) { flush(); return; }
      fakeTime += 1000 / 60;
      for (const id of Array.from(rafQueue.keys())) {
        const cb = rafQueue.get(id);
        if (!cb) continue;
        rafQueue.delete(id);
        try { cb(fakeTime); } catch (_) {}
